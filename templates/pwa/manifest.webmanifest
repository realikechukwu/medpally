{% load static %}{
  "id": "/",
  "name": "{{ SITE_NAME }}",
  "short_name": "{{ SITE_NAME }}",
  "description": "The week's research from the journals you actually read, summarised into a few lines you can scan on the ward.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["medical", "education", "news"],
  "icons": [
    {
      "src": "{% static 'img/brand/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/brand/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/brand/icon-maskable-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'img/brand/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'img/brand/logo-mark.svg' %}",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
