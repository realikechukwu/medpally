# Copy to deploy/oracle/.env and protect it with chmod 600.

# Caddy obtains and renews TLS certificates for this hostname automatically.
DOMAIN=oracle-test.medpally.com
# Keep the temporary hostname reachable while the production hostname is added.
TEST_DOMAIN=oracle-test.medpally.com
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=oracle-test.medpally.com,web.medpally.com,medpally.com,www.medpally.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://oracle-test.medpally.com,https://web.medpally.com,https://medpally.com,https://www.medpally.com
SITE_NAME=MedPally
SITE_BASE_URL=https://oracle-test.medpally.com
MARKETING_BASE_URL=https://web.medpally.com
MARKETING_HOSTS=web.medpally.com,medpally.com,www.medpally.com

# Keep using the Supabase SESSION pooler on port 5432. URL-encode special
# characters in the password. Do not use the transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_CONN_MAX_AGE=0

NCBI_EMAIL=you@example.com
NCBI_API_KEY=
PUBMED_TOOL_NAME=medpally
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MAX_PER_RUN=400
SUMMARY_MIN_ABSTRACT_CHARS=200
INGEST_LOOKBACK_DAYS=3
RELEVANCE_RECHECK_DAYS=90

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL="MedPally <noreply@medpally.com>"

SENTRY_DSN=
SENTRY_ENVIRONMENT=production-oracle
FEED_PAGE_SIZE=20
ENGINE_LOG_LEVEL=INFO

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
