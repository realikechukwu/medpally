# Copy to .env and fill in. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=generate-with-python-c-secrets-token_urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Local dev via docker-compose. In production use the Supabase SESSION pooler
# (aws-0-<region>.pooler.supabase.com:5432) — NOT the transaction pooler on
# 6543, which breaks server-side cursors and migrations.
DATABASE_URL=postgres://medfeed:medfeed@localhost:5433/medfeed
TEST_DATABASE_URL=postgres://medfeed:medfeed@localhost:5433/medfeed_test
# Keep at 0 on Supabase session pooling: each connection holds a pool slot for
# its lifetime and the free-tier pool is ~15.
DB_CONN_MAX_AGE=0

# PubMed E-utilities. An API key raises the rate limit from 3/s to 10/s.
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
PUBMED_TOOL_NAME=medpally

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MAX_PER_RUN=400

INGEST_LOOKBACK_DAYS=3
RELEVANCE_RECHECK_DAYS=90

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth transactional email only (password reset). Digest email stays in the
# cardiology-feed repo for now.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL="MedPally <noreply@medpally.com>"

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SITE_NAME=MedPally
SITE_BASE_URL=http://localhost:8000

FEED_PAGE_SIZE=20
SUMMARY_MIN_ABSTRACT_CHARS=200
ENGINE_LOG_LEVEL=INFO

# Set by Render automatically; production settings add it to ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS so a first deploy works before you hand-copy the URL.
# RENDER_EXTERNAL_HOSTNAME=
